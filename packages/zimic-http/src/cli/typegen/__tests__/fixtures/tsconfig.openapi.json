{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "OpenAPI typegen fixtures",
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["esnext", "dom"],
    "types": [],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "@/index": ["../../../../../index.d.ts"]
    }
  },
  "include": ["openapi/*.ts"]
}
